APP_NAME=SIKDS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://sikds.test
APP_DOMAINE=RECHERCHE

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_DZ

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
#DB_HOST=127.0.0.1
#DB_PORT=5432
#DB_DATABASE=
#DB_USERNAME=
#DB_PASSWORD=

# Use redis in production when PHP ext-redis + Redis server are available
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=recherche_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# The full callback URL registered in your SSO provider (e.g. https://yourdomain.com/callback)
REDIRECT_URI=

# Base URL of the ministry SSO server (e.g. https://sso.mesrs.dz)
SSO_SERVER=

# OAuth2 Client ID issued by the SSO provider
CLIENT_ID=

# OAuth2 Client Secret issued by the SSO provider
CLIENT_SECRET=

# Path on the SSO server for the authorization endpoint (default: /oauth/authorize)
SSO_AUTHORIZE_PATH=/oauth/authorize

# Path on the SSO server for the token exchange endpoint (default: /oauth/token)
SSO_TOKEN_PATH=/oauth/token

# Path on the SSO server to fetch authenticated user info (default: /api/user)
SSO_USERINFO_PATH=/api/user

# OAuth2 scopes to request (space-separated, leave empty for defaults)
SSO_SCOPE=

# Comma-separated list of allowed email domains for SSO login (e.g. mesrs.dz,univ-alger.dz)
SSO_ALLOWED_DOMAINS=
