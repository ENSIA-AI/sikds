# Application
APP_NAME=SIKDS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=80

# Database — PostgreSQL 18
DB_CONNECTION=pgsql
# Shared default across devs (Docker mode)
DB_HOST=postgres
DB_PORT=5432

DB_DATABASE=sikds
DB_USERNAME=sikds

DB_PASSWORD=secret

# Redis 8.6
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Queue & Cache
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
CACHE_PREFIX=sikds_cache
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default

# SeaweedFS (S3-compatible object storage)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=sikds-documents
AWS_ENDPOINT=http://seaweed-s3:8333
AWS_USE_PATH_STYLE_ENDPOINT=true
# Optional host port overrides if defaults are busy on your machine
SEAWEED_MASTER_PORT=9333
SEAWEED_VOLUME_PORT=18080
SEAWEED_FILER_PORT=18888
SEAWEED_S3_PORT=8333

# Ministry SSO
REDIRECT_URI=http://sikds.test/callback
SSO_SERVER=https://accounts.mesrs.dz
CLIENT_ID=your_sso_client_id_here
CLIENT_SECRET=your_sso_client_secret_here
SSO_AUTHORIZE_PATH=/oauth/authorize
SSO_TOKEN_PATH=/oauth/token
SSO_USERINFO_PATH=/api/user
SSO_SCOPE=""
SSO_ALLOWED_DOMAINS=mesrs.dz


# Mail (Mailpit for local dev)
MAIL_MAILER=smtp
# Shared default across devs (Docker mode)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@mesrs.dz
MAIL_FROM_NAME="SIKDS"
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Horizon
HORIZON_DOMAIN=
HORIZON_PATH=horizon
HORIZON_PREFIX=sikds_horizon


# Auth/session optional
AUTH_GUARD=web
AUTH_PASSWORD_BROKER=users
AUTH_MODEL=App\Domain\Users\Models\User
AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
AUTH_PASSWORD_TIMEOUT=10800
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_CONNECTION=
SESSION_TABLE=sessions
SESSION_STORE=
SESSION_SECURE_COOKIE=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

# Logging optional
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_USERNAME="Laravel Log"
LOG_SLACK_EMOJI=:boom:
LOG_PAPERTRAIL_HANDLER=
PAPERTRAIL_URL=
PAPERTRAIL_PORT=
LOG_STDERR_FORMATTER=
LOG_SYSLOG_FACILITY=LOG_USER

# Database/queue/cache optional advanced settings
DB_URL=
DB_FOREIGN_KEYS=true
DB_SOCKET=
DB_CHARSET=utf8
DB_COLLATION=utf8mb4_unicode_ci
DB_CACHE_CONNECTION=
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=
DB_CACHE_LOCK_TABLE=cache_locks
DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids
REDIS_URL=
REDIS_USERNAME=
REDIS_CLUSTER=redis
REDIS_PREFIX=
REDIS_PERSISTENT=false
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE_RETRY_AFTER=90
MEMCACHED_PERSISTENT_ID=
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
DYNAMODB_CACHE_TABLE=cache
DYNAMODB_ENDPOINT=
BEANSTALKD_QUEUE_HOST=localhost
BEANSTALKD_QUEUE=default
BEANSTALKD_QUEUE_RETRY_AFTER=90
SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/your-account-id
SQS_QUEUE=default
SQS_SUFFIX=

# Mail/provider optional
MAIL_SCHEME=null
MAIL_URL=
MAIL_EHLO_DOMAIN=
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
MAIL_LOG_CHANNEL=
POSTMARK_TOKEN=
RESEND_KEY=
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=
AWS_URL=


# ─── RAG ─────
RAG_ENFORCE_AUTH=true

# ─── OCR ─────

OCR_SERVICE_URL=http://surya:8100
OCR_TIMEOUT=300
RAG_OCR_ENABLED=true
OCR_MIN_CHARS_PER_PAGE=50

# Languages surya will recognise — comma-separated codes from languages.py
# ar=Arabic, fr=French — add en=English if needed
SURYA_LANGUAGES=ar,fr

# ─── LLM ─────
RAG_LLM_PROVIDER=groq
RAG_LLM_TIMEOUT=120


RAG_LLM_MODEL=gemma-4-27B-it
RAG_LLM_URL=
LLM_API_KEY=

#RAG_LLM_MODEL=llama-3.3-70b-versatile
#RAG_LLM_URL=https://api.groq.com/openai/v1
#LLM_API_KEY=



# ─── Chunking ─────
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
CHUNK_MIN_TOKENS=40

# ─── Embedding ─────
# For embedding, you can choose between Nomic and Jina. The Nomic model is more compact (768 dimensions) and may be faster, while the Jina model is larger (1024 dimensions) and may provide better quality at the cost of speed and resource usage. Uncomment the one you want to use and provide your API key.

#this here decides if the infinity container that runs infinity and the local embedding model starts (production only), for testing leave COMPOSE_PROFILES empty and uncomment the jina embedding model lines (comment the nomic lines)

COMPOSE_PROFILES=prod
#COMPOSE_PROFILES=

RAG_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v2-moe
RAG_EMBEDDING_URL=http://embeddings:7997
RAG_EMBEDDING_API_KEY=
#RAG_EMBEDDING_MODEL=jina-embeddings-v5-text-small
#RAG_EMBEDDING_URL=https://api.jina.ai/v1
#RAG_EMBEDDING_API_KEY=

RAG_EMBEDDING_DIMS=768


RAG_EMBEDDING_TIMEOUT=60
RAG_EMBEDDING_BATCH_SIZE=32


RAG_EMBEDDING_PASSAGE_TASK=search_document
RAG_EMBEDDING_QUERY_TASK=search_query
#RAG_EMBEDDING_PASSAGE_TASK=retrieval.passage
#RAG_EMBEDDING_QUERY_TASK=retrieval.query


RAG_EMBEDDING_RPM=100
RAG_EMBEDDING_TPM=100000
RAG_EMBEDDING_RATE_HEADROOM=0.80
RAG_EMBEDDING_BACKOFF_429=90

RAG_EMBEDDING_TASK_PARAM=task_type
#RAG_EMBEDDING_TASK_PARAM=task

RAG_EMBEDDING_TASK_MODE=param

# ─── Reranking ─────
RAG_RERANKER_ENABLED=false
RAG_RERANKER_MODEL=jina-reranker-v3
RAG_RERANKER_TOP_N=6
RAG_RERANKER_URL=https://api.jina.ai/v1
RAG_RERANKER_API_KEY=
RAG_RERANKER_TIMEOUT=60

# ─── Retrieval ─────
RAG_CANDIDATE_POOL=20
RAG_MIN_CONFIDENCE=0.10

# ─── Hybrid Search ─────
RAG_HYBRID_SEARCH=true
RAG_RRF_K=60
RAG_BM25_POOL=20

GID=1000
