{
  "name": "mesrs/sikds",
  "type": "project",
  "description": "SIKDS — Secure Institutional Knowledge & Distribution System",
  "keywords": [
    "laravel",
    "framework",
    "sikds"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-curl": "*",
    "ext-pdo": "*",
    "deployer/deployer": "^8.0",
    "laravel/framework": "^13.8",
    "laravel/horizon": "^5.46",
    "laravel/tinker": "^3.0.2",
    "league/flysystem-aws-s3-v3": "^3.32",
    "predis/predis": "^3.4.2",
    "prism-php/prism": "^0.99.22",
    "setasign/fpdf": "^1.8.6",
    "setasign/fpdi": "^2.6.7",
    "smalot/pdfparser": "^2.12.5",
    "spatie/laravel-permission": "^6.25"
  },
  "require-dev": {
    "barryvdh/laravel-debugbar": "^4.2.8",
    "fakerphp/faker": "^1.24.1",
    "larastan/larastan": "^3.9.6",
    "laravel/pail": "^1.2.6",
    "laravel/pint": "^1.29.1",
    "laravel/sail": "^1.58",
    "mockery/mockery": "^1.6.12",
    "nunomaduro/collision": "^8.9.4",
    "pestphp/pest": "^4.7",
    "pestphp/pest-plugin-laravel": "^4.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve --host=0.0.0.0 --port=8000\" \"php artisan horizon\" \"npm run dev\" --names=server,horizon,vite --kill-others"
    ],
    "dev:docker": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"#c4b5fd,#fdba74\" \"php artisan horizon\" \"npm run dev\" --names=horizon,vite --kill-others"
    ],
    "test": [
      "@php artisan config:clear --ansi",
      "@php artisan test"
    ],
    "test:pgsql": [
      "@php artisan config:clear --ansi",
      "@php vendor/bin/pest --configuration phpunit.pgsql.xml"
    ],
    "i18n:scan": [
      "@php artisan i18n:scan"
    ],
    "i18n:lint": [
      "@php artisan i18n:lint"
    ],
    "i18n:check": [
      "@php artisan i18n:scan --check",
      "@php artisan i18n:lint"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    },
    "platform": {
      "php": "8.3.30"
    },
    "platform-check": false
  }
}
