<?xml version="1.0" encoding="UTF-8"?>
<!--
  PostgreSQL test configuration.

  The default phpunit.xml runs on SQLite :memory:, which never exercises the
  Postgres-only paths: the audit_logs immutability triggers, pgvector, and the
  BM25 full-text SQL. Run this config against a DISPOSABLE pgvector database
  (it is migrated with RefreshDatabase):

    composer test:pgsql
    (equivalent to running pest with the option "-c phpunit.pgsql.xml")

  Locally the docker-compose pgvector/pgvector:pg18 service can host a
  `sikds_testing` database; CI provisions its own service container
  (see .github/workflows/tests.yml, job "pgsql").
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory="storage/framework/cache/phpunit"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_KEY" value="base64:2fl+7vP4lNn8KJQxQ0YqZ3vH8mN1pL5sT9wU2cX6bD0="/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="sikds_testing"/>
        <env name="DB_USERNAME" value="sikds"/>
        <env name="DB_PASSWORD" value="secret"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="PHPUNIT_RESULT_CACHE" value="storage/framework/cache/.phpunit.result.cache"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
